{
  "name": "@w8tcha/npm-check",
  "version": "7.0.0",
  "description": "Check for outdated, incorrect, and unused dependencies.",
  "license": "MIT",
  "repository": "github:w8tcha/npm-check",
  "homepage": "https://github.com/w8tcha/npm-check",
  "bugs": "https://github.com/w8tcha/npm-check/issues",
  "author": "Dylan Greene <dylang@gmail.com>",
  "type": "module",
  "exports": {
    "types": "./index.d.ts",
    "default": "./lib/index.js"
  },
  "bin": {
    "@w8tcha/npm-check": "./bin/cli.js"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "lint": "xo",
    "test:unit": "node --experimental-test-module-mocks --test \"test/unit/*.test.js\"",
    "test": "npm run lint && npm run test:unit && (node bin/cli.js || exit 0)",
    "update-deps": "node ./bin/cli.js -u"
  },
  "files": [
    "index.d.ts",
    "bin",
    "lib"
  ],
  "keywords": [
    "npm",
    "outdated",
    "dependencies",
    "unused",
    "changelog",
    "check",
    "updates",
    "api",
    "interactive",
    "cli",
    "safe",
    "updating",
    "updater",
    "installer",
    "devdependencies"
  ],
  "dependencies": {
    "callsite-record": "^4.1.5",
    "chalk": "^6.0.1",
    "depcheck": "^1.4.7",
    "execa": "^10.1.0",
    "giturl": "^2.0.0",
    "global-modules": "^2.0.0",
    "globby": "^16.2.4",
    "inquirer": "^14.2.3",
    "is-ci": "^4.1.0",
    "lodash": "^4.18.1",
    "meow": "^14.1.0",
    "minimatch": "^10.2.6",
    "node-emoji": "^2.2.0",
    "ora": "^9.4.1",
    "package-json": "^10.0.1",
    "path-exists": "^5.0.0",
    "pkg-dir": "^9.0.0",
    "preferred-pm": "^5.0.1",
    "rc-config-loader": "^4.1.4",
    "semver": "^7.8.5",
    "semver-diff": "^5.0.0",
    "strip-ansi": "^7.2.0",
    "text-table": "^0.2.0",
    "throat": "^6.0.2",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "xo": "^5.0.1"
  },
  "xo": [
    {
      "ignores": [
        "index.d.ts",
        "test/fixtures/**"
      ]
    },
    {
      "space": 4,
      "rules": {
        "no-warning-comments": [
          0
        ]
      }
    },
    {
      "files": [
        "test/unit/*.test.js"
      ],
      "rules": {
        "node-test/no-import-test-files": "off"
      }
    }
  ]
}
